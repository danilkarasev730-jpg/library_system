class Book:
    def __init__(self, book_id, title, author, pages):
        self.id = book_id
        self.title = title
        self.author = author
        self.pages = pages

    def get_info(self):
        return f"«{self.title}» (Автор: {self.author}, страниц: {self.pages})"

class Library:
    def __init__(self):
        self.users_db = {"@fhgh1.rksaz": "12345"}
        self.books_db = {
            105: Book(105, "Арап", "А.С. Пушкин", 365),
            101: Book(101, "Война и мир", "Л.Н. Толстой", 1300),
            102: Book(102, "Преступление и наказание", "Ф.М. Достоевский", 500)
        }
        
        self.current_user = None
        self.current_book = None
        self.current_page = 1

    def search_book(self):
        print("\n[ПОИСК] Введите ID книги (например, 105):")
        try:
            book_id = int(input("> "))
            if book_id in self.books_db:
                book = self.books_db[book_id]
                print(f"[РЕЗУЛЬТАТ]: Найдена книга {book.get_info()}")
            else:
                print("[ОШИБКА]: Книга с таким ID не найдена.")
        except ValueError:
            print("[ОШИБКА]: Введите число.")

    def register(self):
        print("\n[РЕГИСТРАЦИЯ / ВХОД]")
        email = input("Введите email: ")
        password = input("Введите пароль: ")
        
        if email in self.users_db:
            print("\n[ОШИБКА]: Пользователь с таким email уже существует.")
        else:
            self.users_db[email] = password
            print("\n[УСПЕХ]: Вы успешно зарегистрированы и вошли в систему!")
            self.current_user = email

    def open_book(self):
        print("\n[ОТКРЫТИЕ КНИГИ] Введите ID книги (например, 105):")
        try:
            book_id = int(input("> "))
            if book_id in self.books_db:
                self.current_book = self.books_db[book_id]
                self.current_page = 1
                print(f"\n[УСПЕХ]: Книга {self.current_book.title} открыта на 1-й странице.")
            else:
                print("[ОШИБКА]: Книги с таким ID нет.")
        except ValueError:
            print("[ОШИБКА]: Введите число.")

    def read_book(self):
        if not self.current_book:
            print("[ОШИБКА]: Сначала откройте книгу (пункт 2).")
            return
            
        print("\n[ЧТЕНИЕ]")
        if not self.current_user:
            print("Мы заметили, что Вы работаете без авторизации. Войдите в систему и воспользуйтесь полным функционалом!")
        else:
            print(f"--- Страница {self.current_page} ---")
            print(f"(Здесь могла быть ваша страница из книги «{self.current_book.title}»...)")
            print("-" * 20)

    def next_page(self):
        if not self.current_book:
            return
        if self.current_page >= self.current_book.pages:
            print("[СИСТЕМА]: Вы уже на последней странице!")
        else:
            self.current_page += 1
            print(f"\n[СИСТЕМА]: Загрузка страницы {self.current_page}...")
            print(f"--- Страница {self.current_page} из {self.current_book.pages} ---")

    def goto_end(self):
        if not self.current_book:
            return
        self.current_page = self.current_book.pages
        print(f"\n[СИСТЕМА]: Переход в конец книги...")
        print(f"--- Вы на последней странице ({self.current_page} из {self.current_book.pages}) ---")

    def print_menu(self):
        print("\n" + "="*40)
        print("СИСТЕМА УПРАВЛЕНИЯ БИБЛИОТЕКОЙ")
        if self.current_user:
            print(f"Вы вошли как: {self.current_user}")
        else:
            print("Вы вошли как: Гость (не авторизован)")
        print("="*40)
        print("1. Поиск книги")
        print("2. Открыть книгу (по ID)")
        if self.current_book:
            print("   [Книга открыта]: " + self.current_book.title)
            print("   - Введите 1, чтобы перелистнуть на след. страницу")
            print("   - Введите 9, чтобы перейти в конец книги")
            print("   - Введите 0, чтобы закрыть книгу")
        else:
            print("3. Регистрация / Вход")
        print("4. Выход")
        print("="*40)

    def run(self):
        while True:
            self.print_menu()
            
            if self.current_book:
                choice = input("Введите номер действия: ")
                if choice == "1":
                    self.next_page()
                elif choice == "9":
                    self.goto_end()
                elif choice == "0":
                    self.current_book = None
                    print("[СИСТЕМА]: Книга закрыта.")
                elif choice == "4":
                    break
                else:
                    print("[ОШИБКА]: Неверная команда.")
                    
            else:
                choice = input("Введите номер действия: ")
                if choice == "1":
                    self.search_book()
                elif choice == "2":
                    self.open_book()
                    if self.current_book:
                        self.read_book()
                elif choice == "3":
                    self.register()
                elif choice == "4":
                    break
                else:
                    print("[ОШИБКА]: Неверная команда.")

if __name__ == "__main__":
    my_library = Library()
    my_library.run()
