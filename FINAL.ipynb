import time

baza_polzovateley = {"@fhgh1.rksaz": "12345"} 
baza_knig = {
    105: {"nazvanie": "Арап", "avtor": "А.С. Пушкин", "stranic": 365},
    101: {"nazvanie": "Война и мир", "avtor": "Л.Н. Толстой", "stranic": 1300}
}

tekushiy_polzovatel = None  
tekushaya_kniga = None      
tekushaya_stranica = 1      

def pokazat_menu():
    print("\n" + "="*40)
    print("СИСТЕМА УПРАВЛЕНИЯ БИБЛИОТЕКОЙ")
    
    if tekushiy_polzovatel:
        print(f"Вы вошли как: {tekushiy_polzovatel}")
    else:
        print("Вы вошли как: Гость (не авторизован)")
        
    print("="*40)
    print("1. Поиск книги")
    print("2. Открыть книгу (по ID)")
    
    if tekushaya_kniga:
        print("   [Книга открыта]: " + tekushaya_kniga['nazvanie'])
        print("   - Введите 1, чтобы перелистнуть на след. страницу (Тест 3)")
        print("   - Введите 9, чтобы перейти в конец книги (Тест 5)")
        print("   - Введите 0, чтобы закрыть книгу")
    else:
        print("3. Регистрация / Вход")
        
    print("4. Выход")
    print("="*40)


def poisk_knigi():
    print("\n[ПОИСК] Введите ID книги (например, 105):")
    vvod = input("> ")
    
    try:
        id_knigi = int(vvod)
        if id_knigi in baza_knig:
            k = baza_knig[id_knigi]
            print(f"[РЕЗУЛЬТАТ]: Найдена книга «{k['nazvanie']}» (Автор: {k['avtor']}, страниц: {k['stranic']})")
        else:
            print("[ОШИБКА]: Книга с таким ID не найдена.")
    except ValueError:
        print("[ОШИБКА]: Нужно ввести цифру, а не текст!")


def registraciya():
    print("\n[РЕГИСТРАЦИЯ / ВХОД]")
    email = input("Введите email: ")
    parol = input("Введите пароль: ")
    
    if email in baza_polzovateley:
        print("\n[ОШИБКА]: Пользователь с таким email уже существует.")
    else:
        baza_polzovateley[email] = parol
        print("\n[УСПЕХ]: Вы успешно зарегистрированы и вошли в систему!")
        
        global tekushiy_polzovatel
        tekushiy_polzovatel = email


def otkryt_knigu():
    print("\n[ОТКРЫТИЕ КНИГИ] Введите ID книги (например, 105):")
    vvod = input("> ")
    
    try:
        id_knigi = int(vvod)
        if id_knigi in baza_knig:
            global tekushaya_kniga, tekushaya_stranica
            tekushaya_kniga = baza_knig[id_knigi]
            tekushaya_stranica = 1
            print(f"\n[УСПЕХ]: Книга «{tekushaya_kniga['nazvanie']}» открыта.")
        else:
            print("[ОШИБКА]: Книги с таким ID нет.")
    except ValueError:
        print("[ОШИБКА]: Нужно ввести цифру!")


def chitat_knigu():
    if not tekushaya_kniga:
        print("[ОШИБКА]: Сначала откройте книгу (пункт 2).")
        return
        
    print("\n[ЧТЕНИЕ]")
    
    if not tekushiy_polzovatel:
        print("Мы заметили, что Вы работаете без авторизации. Войдите в систему и воспользуйтесь полным функционалом!")
    else:
        print(f"--- Страница {tekushaya_stranica} из {tekushaya_kniga['stranic']} ---")
        print(f"(Здесь начинается текст книги «{tekushaya_kniga['nazvanie']}»...)")
        print("-" * 20)


def sleduyushaya_stranica():
    global tekushaya_stranica
    if not tekushaya_kniga:
        return
    
    if tekushaya_stranica >= tekushaya_kniga['stranic']:
        print("[СИСТЕМА]: Вы уже на последней странице!")
    else:
        tekushaya_stranica += 1
        print(f"\n[СИСТЕМА]: Загрузка страницы {tekushaya_stranica}...")
        print(f"--- Страница {tekushaya_stranica} из {tekushaya_kniga['stranic']} ---")


def v_konec_knigi():
    global tekushaya_stranica
    if not tekushaya_kniga:
        return
        
    tekushaya_stranica = tekushaya_kniga['stranic']
    print(f"\n[СИСТЕМА]: Переход в конец книги...")
    print(f"--- Вы на последней странице ({tekushaya_stranica} из {tekushaya_kniga['stranic']}) ---")


def main():
    global tekushaya_kniga
    
    while True:
        pokazat_menu()
        
        if tekushaya_kniga:
            vybor = input("Введите номер действия: ")
            if vybor == "1":
                sleduyushaya_stranica() 
            elif vybor == "9":
                v_konec_knigi() 
            elif vybor == "0":
                tekushaya_kniga = None
                print("[СИСТЕМА]: Книга закрыта.")
            elif vybor == "4":
                break
            else:
                print("[ОШИБКА]: Неверная команда.")
                
        else:
            vybor = input("Введите номер действия: ")
            if vybor == "1":
                poisk_knigi() 
                
            elif vybor == "2":
                otkryt_knigu() 
                
                if tekushaya_kniga:
                    chitat_knigu() 
                    
            elif vybor == "3":
                registraciya() 
                
            elif vybor == "4":
                break
            else:
                print("[ОШИБКА]: Неверная команда.")


if __name__ == "__main__":
    main()
